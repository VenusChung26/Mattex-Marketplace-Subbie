{
  "name": "subbie-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "supabase:seed": "node scripts/seed-supabase.mjs",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "prototype:rfq": "vite --open /rfq?variant=A",
    "prototype:quotes": "vite --open /rfqs?variant=A",
    "prototype:website": "vite --open /?variant=A",
    "prototype:whatsapp": "vite --open /whatsapp-chat?variant=A",
    "prototype:logic": "python3 -m http.server 8766 --directory public"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "@vercel/blob": "^2.8.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
